<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Käännösmallien kertalataus; itse käännös ja kaikki oppiminen
         tapahtuvat laitteella, eikä kirjoitettua tekstiä lähetetä minnekään. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sanelun mikrofoni; puhe käsitellään laitteen puheentunnistuspalvelussa. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Automaattinen pilvivarmistus ja laitesiirto pois: oppimisdata ja
         leikkeet pysyvät laitteella, ja siirto tehdään käyttäjän omalla
         varmuuskopiolla. -->
    <application
        android:name=".ArkApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/varmistussaannot"
        android:fullBackupContent="@xml/taysvarmistus"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ark">

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.IntroActivity"
            android:exported="false"
            android:label="@string/esittely" />

        <activity
            android:name=".settings.LearnedWordsActivity"
            android:exported="false"
            android:label="@string/opitut_sanat" />

        <activity
            android:name=".settings.SymbolOrderActivity"
            android:exported="false"
            android:label="@string/erikoismerkit" />

        <activity
            android:name=".settings.ToolbarOrderActivity"
            android:exported="false"
            android:label="@string/tyokalurivi" />

        <activity
            android:name=".settings.TranslationLanguagesActivity"
            android:exported="false"
            android:label="@string/kaannoskielet" />

        <activity
            android:name=".dictation.RecordAudioPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Ark.Lapinakyva" />

        <activity
            android:name=".clipboard.NewClipActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Ark.Lapinakyva" />

        <!-- Kuvaleikkeiden luovutus vastaanottavalle sovellukselle. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.jarsi.ark.nappaimisto.tiedostot"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/tiedostopolut" />
        </provider>
    </application>
</manifest>

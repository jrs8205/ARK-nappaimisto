        <item name="colorPrimary">@color/tumma_korostus</item>
        <item name="colorOnPrimary">@color/tumma_korostusteksti</item>
        <item name="android:colorBackground">@color/tumma_tausta</item>
        <item name="colorSurface">@color/tumma_nappain</item>
        <item name="colorOnSurface">@color/tumma_teksti</item>
        <item name="colorSurfaceVariant">@color/tumma_erikoisnappain</item>

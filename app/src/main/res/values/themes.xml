<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/ArkPreferenceTheme</item>
        <item name="colorPrimary">@color/vaalea_korostus</item>
        <item name="colorOnPrimary">@color/vaalea_korostusteksti</item>
        <item name="android:colorBackground">@color/vaalea_tausta</item>
        <item name="colorSurface">@color/vaalea_nappain</item>
        <item name="colorOnSurface">@color/vaalea_teksti</item>
        <item name="colorSurfaceVariant">@color/vaalea_erikoisnappain</item>
        <item name="colorOnSurfaceVariant">@color/vaalea_vihje</item>
        <item name="colorSurfaceContainer">@color/vaalea_nappain</item>
        <item name="colorSurfaceContainerHighest">@color/vaalea_kortti</item>
    </style>

    <!-- Asetusrivit pyöristettyinä kortteina ja modernit M3-kytkimet.
         Material You -laitteilla värit tulevat taustakuvasta. -->
    <style name="ArkPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/ArkPreference</item>
        <item name="preferenceCategoryStyle">@style/ArkPreferenceCategory</item>
        <item name="switchPreferenceCompatStyle">@style/ArkSwitchPreference</item>
        <item name="seekBarPreferenceStyle">@style/ArkSeekBarPreference</item>
        <item name="editTextPreferenceStyle">@style/ArkEditTextPreference</item>
    </style>

    <style name="ArkPreference" parent="@style/Preference.Material">
        <item name="android:layout">@layout/asetus_rivi</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="ArkPreferenceCategory" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/asetus_otsikkorivi</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="ArkSwitchPreference" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/asetus_rivi</item>
        <item name="android:widgetLayout">@layout/asetus_kytkin</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="ArkSeekBarPreference" parent="@style/Preference.SeekBarPreference.Material">
        <item name="android:layout">@layout/asetus_liukurivi</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="ArkEditTextPreference" parent="@style/Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/asetus_rivi</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!-- Emojivalitsin: valitun kategorian merkkiviiva näppäimistön korostusvärillä. -->
    <style name="Theme.Ark.EmojiValitsin">
        <item name="colorAccent">@color/vaalea_korostus</item>
        <item name="colorControlActivated">@color/vaalea_korostus</item>
        <item name="colorSecondary">@color/vaalea_korostus</item>
    </style>

    <!-- Läpinäkyvä teema lupakyselylle: näppäimistön alla oleva sovellus jää näkyviin. -->
    <style name="Theme.Ark.Lapinakyva">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
